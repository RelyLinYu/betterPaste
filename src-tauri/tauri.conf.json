{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipstack",
  "version": "0.1.0",
  "identifier": "clipstack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "clipstack",
        "url": "overlay.html",
        "width": 760,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "settings",
        "title": "clipstack 设置",
        "url": "settings.html",
        "width": 720,
        "height": 620,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": [],
    "copyright": "MIT Licensed",
    "category": "Utility",
    "shortDescription": "Clipboard history manager for Windows",
    "longDescription": "An offline clipboard history manager for Windows: search, images, pinned slots and byte-exact plain-text paste. A drop-in replacement for Win+V.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
